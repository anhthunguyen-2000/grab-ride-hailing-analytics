{
  "name": "Grab Mobility Portfolio",
  "dataColors": [
    "#00B14F",
    "#477E9B",
    "#F5A623",
    "#94B9A2",
    "#E45757",
    "#7C78A6",
    "#008C3A",
    "#66756D"
  ],
  "background": "#F7FAF8",
  "foreground": "#172B24",
  "tableAccent": "#00B14F",
  "good": "#00B14F",
  "neutral": "#F5A623",
  "bad": "#E45757",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#172B24"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#008C3A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#172B24"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#66756D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3ECE6"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#008C3A"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": true
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#172B24"
              }
            },
            "textSize": 10
          }
        ],
        "header": [
          {
            "show": false
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": true
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#008C3A"
              }
            },
            "fontSize": 28
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#66756D"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#008C3A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#E8F7EE"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3ECE6"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#008C3A"
              }
            },
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#172B24"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontSize": 10
          }
        ],
        "subTotals": [
          {
            "rowSubtotals": false,
            "columnSubtotals": false
          }
        ],
        "rowTotal": [
          {
            "show": false
          }
        ],
        "columnTotal": [
          {
            "show": false
          }
        ]
      }
    }
  }
}